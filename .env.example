# SubscriptIQ Environment Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subscriptiq?schema=public"

# Authentication & Security
JWT_SECRET="subscriptiq-production-secure-jwt-key-at-least-32-characters"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="subscriptiq-secure-cookie-secret-key-32-characters"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional Grok / xAI Integration
# If left blank or unconfigured, the system gracefully falls back to the deterministic Mock AI Provider
GROK_API_KEY=""
GROK_API_URL="https://api.x.ai/v1"
GROK_MODEL="grok-beta"
